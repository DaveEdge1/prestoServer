# Presto Server — production environment template
# -------------------------------------------------------------------
# Copy to /srv/presto/.env.production on the university server,
# fill in real values, then: chmod 600 /srv/presto/.env.production
#
# DO NOT commit the real .env.production (it's in .gitignore).
# -------------------------------------------------------------------

# -------- Public URL --------
# Must match the subdomain IT has configured upstream
BASE_URL=https://custom.paleopresto.com
CORS_ORIGINS=https://custom.paleopresto.com

# -------- GitHub OAuth (production app, separate from dev) --------
# Register a NEW OAuth app for production at
# https://github.com/settings/developers with:
#   Homepage URL:                 https://custom.paleopresto.com/
#   Authorization callback URL:   https://custom.paleopresto.com/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=https://custom.paleopresto.com/oauth/github/callback
GITHUB_DEFAULT_VISIBILITY=public
GITHUB_WEBHOOK_SECRET=

# -------- GitHub App (optional, for anonymous/centralized repos) --------
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_PATH=/srv/presto/secrets/github-app-private-key.pem
GITHUB_APP_ORG=presto-reconstructions
# GITHUB_APP_DISABLED=true   # uncomment to temporarily disable

# -------- Security secrets --------
# Generate both with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating ENCRYPTION_KEY invalidates all encrypted GitHub tokens in the
# github_tokens table (users must re-auth). Fine on a fresh prod DB.
ENCRYPTION_KEY=
SESSION_SECRET=

# -------- MySQL --------
# MYSQL_HOST is fixed to "mysql" (the compose service name); do not set here.
MYSQL_USER=presto
MYSQL_PASSWORD=
MYSQL_DATABASE=lipdverse
MYSQL_ROOT_PASSWORD=

# -------- SMTP (Zoho) --------
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_USER=no-reply@paleopresto.com
SMTP_PASSWORD=
SMTP_FROM=no-reply@paleopresto.com

# -------- External services --------
GRAPHDB_URL=https://linkedearth.graphdb.mint.isi.edu

# -------- Monitoring (Grafana) --------
# Grafana is bound to 127.0.0.1:3001 on this host and reached via
# SSH tunnel — but pick a strong password anyway (anyone with SSH
# on the host can hit the local port).
GRAFANA_USER=admin
GRAFANA_PASSWORD=
