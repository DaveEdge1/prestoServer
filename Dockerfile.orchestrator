# App layer for the Presto orchestrator. Builds on
# davidedge/presto-orchestrator-base, which has R + tidyverse + lipdR +
# sf-stack system libs + Docker CLI baked in. This file only handles
# npm deps and app code, so rebuilds take 1-2 min instead of 30+.
#
# To bump the R/system-deps base, see Dockerfile.orchestrator-base — and
# update the FROM tag below in the same commit so the two stay in sync.

FROM davidedge/presto-orchestrator-base:r-2026-05-06

WORKDIR /root/presto

# Copy package manifests first so npm install caches independently of
# application source.
COPY package*.json ./
RUN npm install --omit=dev

# Application source. .dockerignore excludes scratch dirs.
COPY . .

ENV NODE_ENV=production
EXPOSE 3000

CMD ["node", "app.js"]
