FROM node:20-bookworm

# Install R and dependencies for downloadLipds.js which runs R scripts, plus Docker CLI for prestoGo.js
# Also install spatial libraries required by sf package and its dependencies
# Debian Bookworm provides R 4.2+ which is compatible with modern tidyverse packages
RUN apt-get update && apt-get install -y \
    r-base \
    r-base-dev \
    libcurl4-openssl-dev \
    libssl-dev \
    libxml2-dev \
    curl \
    ca-certificates \
    gnupg \
    lsb-release \
    cmake \
    libudunits2-dev \
    libgdal-dev \
    libgeos-dev \
    libproj-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Docker CLI (required by prestoGo.js to spawn reconstruction containers)
RUN mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://download.docker.com/linux/debian/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/debian $(lsb_release -cs) stable" | tee /etc/apt/sources.list.d/docker.list > /dev/null \
    && apt-get update \
    && apt-get install -y docker-ce-cli \
    && rm -rf /var/lib/apt/lists/*

# Install R packages required by the getLipds scripts
# Install base packages, tidyverse (for stringr, dplyr, purrr, tidyr), furrr, then lipdR from GitHub
RUN R -e "install.packages(c('jsonlite', 'magrittr', 'remotes', 'tidyverse', 'furrr'), repos='https://cran.r-project.org')" \
    && R -e "remotes::install_github('nickmckay/lipdR')"

# Set working directory to match host path structure (same-path mounting)
WORKDIR /root/presto

# Copy package.json and install dependencies for consolidated server
COPY package*.json ./
RUN npm install --omit=dev

# Copy all application code
COPY . .

ENV NODE_ENV=production
EXPOSE 3000

CMD ["node", "app.js"]
