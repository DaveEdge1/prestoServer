# Presto Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ===========================================
# SMTP Configuration (Required)
# Used by prestoGo.js to send result emails
# ===========================================
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_USER=no-reply@paleopresto.com
SMTP_PASSWORD=your_smtp_password_here
SMTP_FROM=no-reply@paleopresto.com

# ===========================================
# MySQL Database Configuration (Required)
# Used by queryDB.js for data queries
# ===========================================
MYSQL_HOST=localhost
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=lipdverse
MYSQL_ROOT_PASSWORD=your_mysql_root_password

# ===========================================
# GitHub OAuth Configuration (Optional - For Personal Repos)
# Users can login to store results in their own GitHub account
# Register OAuth app at: https://github.com/settings/developers
# ===========================================
GITHUB_CLIENT_ID=Ov23liRXr5qy1HEQbWi0
GITHUB_CLIENT_SECRET=265d0daada1c027fe33569e6896b0412a0aa26c6
GITHUB_CALLBACK_URL=https://paleopresto.com/custom
GITHUB_DEFAULT_VISIBILITY=public

# ===========================================
# GitHub App Configuration (Optional - For Anonymous/Centralized Repos)
# Allows anonymous reconstructions without user login
# Register GitHub App at: https://github.com/organizations/YOUR_ORG/settings/apps/new
# ===========================================
GITHUB_APP_ID=your_github_app_id
GITHUB_APP_INSTALLATION_ID=your_installation_id
GITHUB_APP_PRIVATE_KEY_PATH=/path/to/private-key.pem
# Or provide private key directly (useful for Docker secrets):
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYour key here\n-----END RSA PRIVATE KEY-----"
GITHUB_APP_ORG=presto-reconstructions
# GITHUB_APP_DISABLED=false  # Set to true to temporarily disable GitHub App

# ===========================================
# Security Configuration
# ===========================================
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your_encryption_key_32_chars
SESSION_SECRET=your_session_secret_change_in_production

# ===========================================
# Optional Configuration
# ===========================================
GRAPHDB_URL=https://linkedearth.graphdb.mint.isi.edu
BASE_URL=http://143.198.98.66

# ===========================================
# Server Ports (defaults shown)
# ===========================================
# PORT=3000                 # prestoServer
# DOWNLOAD_SERVER_PORT=3001
# FORM_SERVER_PORT=3002
# EDITOR_SERVER_PORT=3004
# QUERY_SERVER_PORT=3006
# QUERY_DB_PORT=3007
# SPARQL_SERVER_PORT=3009
# RSERVER_PORT=3010
# VIZ_SERVER_PORT=3011
