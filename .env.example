# Presto Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ===========================================
# SMTP Configuration (Required)
# Used by prestoGo.js to send result emails
# ===========================================
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_USER=no-reply@paleopresto.com
SMTP_PASSWORD=your_smtp_password_here
SMTP_FROM=no-reply@paleopresto.com

# ===========================================
# MySQL Database Configuration (Required)
# Used by queryDB.js for data queries
# ===========================================
MYSQL_HOST=localhost
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=lipdverse
MYSQL_ROOT_PASSWORD=your_mysql_root_password

# ===========================================
# GitHub OAuth & Actions Configuration (Optional)
# Required for GitHub Actions reconstruction integration
# Register OAuth app at: https://github.com/settings/developers
# ===========================================
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_WEBHOOK_SECRET=random_secure_string_32_chars
GITHUB_CALLBACK_URL=http://localhost:3000/oauth/github/callback
GITHUB_DEFAULT_VISIBILITY=public

# ===========================================
# Security Configuration
# ===========================================
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your_encryption_key_32_chars
SESSION_SECRET=your_session_secret_change_in_production

# ===========================================
# Optional Configuration
# ===========================================
GRAPHDB_URL=https://linkedearth.graphdb.mint.isi.edu
BASE_URL=http://143.198.98.66

# ===========================================
# Server Ports (defaults shown)
# ===========================================
# PORT=3000                 # prestoServer
# DOWNLOAD_SERVER_PORT=3001
# FORM_SERVER_PORT=3002
# EDITOR_SERVER_PORT=3004
# QUERY_SERVER_PORT=3006
# QUERY_DB_PORT=3007
# SPARQL_SERVER_PORT=3009
# RSERVER_PORT=3010
# VIZ_SERVER_PORT=3011
