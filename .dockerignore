# Git repository
.git
.gitignore

# Node modules (already handled by package.json)
node_modules

# Local development files — broad pattern so .env.example / .env.production /
# anything with committed or leaked secrets never ends up in a published image.
.env
.env.*

# IDE files
.vscode
.idea
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Temporary files
*.tmp
*.temp
nul

# Scratch / dev-only directories — not needed at runtime, otherwise bloat
# the build context (temp/ alone has been 3+ GB of cloned templates).
temp/
viz/
userRecons/
loadtest/
query/csv_cache/
query/verification_output/

# Local SQL dump kept in-repo for reference / inspection. Hundreds of MB,
# not used by the running orchestrator.
lipdverse_dump.sql/

# Cached CSV exports — runtime fetches a fresh copy from lipdverse.org as needed
getLipds/lipdverseQuery.csv
getLipds/lipdverseQuery.zip
getLipds/lipdverseQuery.md5
query/lipdverseQuery.md5

# Documentation
*.md
!README.md

# Claude files
.claude
