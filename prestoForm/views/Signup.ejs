<!DOCTYPE html>
<html>

<head>
	<title>Configs Upload</title>
</head>

<body>
	<h1><%= titleHeading %></h1>

	<h3>Default configuration:</h3>
	        <a href = <%= hrefConfig %> target="_blank" >
                <button id = "download-link">See documentation</button>
                </a> <br> <br>

	        <a href="/configDownload" download  type="application/octet-stream">
                <button id = "download-link">Download Original Default Configs</button>
		</a> <br> <br>

	<form action="/uploadConfigs"
	enctype="multipart/form-data" method="POST">
              
		<h3>Upload new configuration file:</h3>
		<input type="file" name="conf" required/> <br>
		<input type="submit" value="submit">
	</form>
</body>

</html>
